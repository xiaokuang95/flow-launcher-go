    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="plugin_copyq_pin">Pin this item</system:String>
    <system:String x:Key="plugin_copyq_remove">Remove this item</system:String>
    <system:String x:Key="plugin_copyq_clear">Empty the clipboard history</system:String>
    <system:String x:Key="plugin_copyq_choose">Put it back on the clipboard</system:String>
